	// ============================================================
	// ATTENDANCE
	// ============================================================
	// attendanceTimeMap:
	// Stores the converted Time value.
	//
	// attendanceMinutesMap:
	// Stores total worked minutes as a number.
	//
	// attendanceDisplayMap:
	// Stores the original Final_Time text for the tooltip.
	// ============================================================
	attendanceTimeMap = Map();
	attendanceMinutesMap = Map();
	attendanceDisplayMap = Map();

	fullDayMinutes = 480;
	halfDayMinutes = 240;

	try
	{
		apmData = thisapp.attendance_app.Get_Employee_Data_From_APM();

		if(apmData != null && apmData.size() > 0)
		{
			for each rec in apmData
			{
				if(rec != null)
				{
					recEmail = ifnull(rec.get("EmployeeEmail"),"").toString();

					if(recEmail == input.employee_email)
					{
						recDate = rec.get("Date");

						// Read Final_Time first
						finalTimeRaw = rec.get("Final_Time");

						// Fallback for old response data
						if(finalTimeRaw == null)
						{
							finalTimeRaw = rec.get("Hoursworked");
						}

						finalTimeText = ifnull(finalTimeRaw,"").toString().trim();

						if(recDate != null && finalTimeText != "")
						{
							gotDate = false;

							try
							{
								recDateObj = recDate.toDate("yyyy-MM-dd");
								gotDate = true;
							}
							catch(eDate1)
							{
								try
								{
									recDateObj = recDate.toDate("dd-MMM-yyyy");
									gotDate = true;
								}
								catch(eDate2)
								{
									try
									{
										recDateObj = recDate.toDate("dd-MM-yyyy");
										gotDate = true;
									}
									catch(eDate3)
									{
										try
										{
											recDateObj = recDate.toDate("MM-dd-yyyy");
											gotDate = true;
										}
										catch(eDate4)
										{
											try
											{
												recDateObj = recDate;
												yearValue = recDate.getYear();
												gotDate = true;
											}
											catch(eDate5)
											{
												gotDate = false;
											}
										}
									}
								}
							}

							if(gotDate && recDateObj >= monthStart && recDateObj <= monthEnd)
							{
								try
								{
									// ====================================================
									// CONVERT Final_Time STRING TO TIME VALUE
									// Example: "05:34"
									// ====================================================
									formatPattern = "HH:mm";

									finalTimeValue = finalTimeText.toTime(formatPattern);

									// Use the methods from your example
									timeashour = finalTimeValue.getHour().toNumber();
									timeasminutes = finalTimeValue.getMinutes().toNumber();

									// Correct 60-minute calculation
									totalWorkedMinutes = (timeashour * 60) + timeasminutes;

									attendanceKey = recDateObj.toString("yyyy-MM-dd");

									// Store the converted Time value
									attendanceTimeMap.put(attendanceKey,finalTimeValue);

									// Store total minutes for comparison
									attendanceMinutesMap.put(attendanceKey,totalWorkedMinutes);

									// Store original value for tooltip
									attendanceDisplayMap.put(attendanceKey,finalTimeText);
								}
								catch(eTimeConversion)
								{
									// Invalid Final_Time values are ignored
								}
							}
						}
					}
				}
			}
		}
	}
	catch(eAttendance)
	{
	}

	// ============================================================
	// HOLIDAYS
	// ============================================================
	holidayDates = List();
	holidayNames = List();

	try
	{
		for each hRec in Holiday_Calendar
		{
			rawHolidayVal = ifnull(hRec.Date_field,"").toString();

			if(rawHolidayVal != "")
			{
				hObj = null;
				parsedOK = false;

				try
				{
					hObj = rawHolidayVal.toDate("MM-dd-yyyy");
					parsedOK = true;
				}
				catch(eHoliday1)
				{
				}

				if(!parsedOK)
				{
					try
					{
						hObj = rawHolidayVal.toDate("yyyy-MM-dd");
						parsedOK = true;
					}
					catch(eHoliday2)
					{
					}
				}

				if(!parsedOK)
				{
					try
					{
						hObj = rawHolidayVal.toDate("dd-MMM-yyyy");
						parsedOK = true;
					}
					catch(eHoliday3)
					{
					}
				}

				if(!parsedOK)
				{
					try
					{
						hObj = rawHolidayVal.toDate("dd-MM-yyyy");
						parsedOK = true;
					}
					catch(eHoliday4)
					{
					}
				}

				if(!parsedOK)
				{
					try
					{
						hObj = hRec.Date_field;
						parsedOK = true;
					}
					catch(eHoliday5)
					{
					}
				}

				if(parsedOK && hObj != null)
				{
					if(hObj >= monthStart && hObj <= monthEnd)
					{
						holidayDates.add(hObj.toString("yyyy-MM-dd"));

						holidayName = "Holiday";

						try
						{
							holidayName = ifnull(hRec.Event_Name,"Holiday").toString();
						}
						catch(eHolidayName)
						{
							holidayName = "Holiday";
						}

						holidayNames.add(holidayName);
					}
				}
			}
		}
	}
	catch(eHolidayAll)
	{
	}

	// ============================================================
	// LEAVES
	// ============================================================
	leaveDates = List();
	leaveTypes = List();
	leaveBrs = List();

	try
	{
		// Fetch approved leaves
		// Employee email is checked first.
		// Employee name is used as fallback.
		for each leaveEntry in Request_Leave[Approval_status == "Approved"]
		{
			leaveEmployeeEmail = "";
			leaveEmployeeName = "";

			try
			{
				leaveEmployeeEmail = ifnull(leaveEntry.Employee_Name.Email,"").toString();
			}
			catch(eLeaveEmail)
			{
				leaveEmployeeEmail = "";
			}

			try
			{
				leaveEmployeeName = ifnull(leaveEntry.Employee_Name.Name,"").toString();
			}
			catch(eLeaveName)
			{
				leaveEmployeeName = "";
			}

			leaveMatches = false;

			if(leaveEmployeeEmail == input.employee_email)
			{
				leaveMatches = true;
			}
			else if(leaveEmployeeEmail == "" && leaveEmployeeName == targetEmpName)
			{
				leaveMatches = true;
			}

			if(leaveMatches)
			{
				fromDate = null;
				toDate = null;

				try
				{
					fromDate = leaveEntry.From;
				}
				catch(eFromDate)
				{
				}

				try
				{
					toDate = leaveEntry.To;
				}
				catch(eToDate)
				{
				}

				if(fromDate != null)
				{
					if(toDate == null)
					{
						toDate = fromDate;
					}

					leaveTypeRaw = "";

					try
					{
						leaveTypeRaw = ifnull(leaveEntry.Leave_Days_Details.Leave_Type.Leave_Type,"").toString();
					}
					catch(eLeaveType)
					{
						leaveTypeRaw = "";
					}

					sickTaken = 0.0;

					try
					{
						sickTaken = ifnull(leaveEntry.Sick_Taken,0).toString().toDecimal();
					}
					catch(eSickTaken)
					{
						sickTaken = 0.0;
					}

					casualTaken = 0.0;

					try
					{
						casualTaken = ifnull(leaveEntry.Casual_Taken,0).toString().toDecimal();
					}
					catch(eCasualTaken)
					{
						casualTaken = 0.0;
					}

					noOfDaysLeave = 0.0;

					try
					{
						noOfDaysLeave = ifnull(leaveEntry.No_Of_Days_Leave,0).toString().toDecimal();
					}
					catch(eNumberLeave)
					{
						noOfDaysLeave = 0.0;
					}

					br = "";

					try
					{
						commentText = ifnull(leaveEntry.Comments,"").toString().toLowerCase();

						if(commentText.contains("first half") || commentText.contains("1st half"))
						{
							br = "FH";
						}
						else if(commentText.contains("second half") || commentText.contains("2nd half"))
						{
							br = "SH";
						}
					}
					catch(eBreak)
					{
						br = "";
					}

					if(br == "" && noOfDaysLeave == 0.5)
					{
						br = "half";
					}

					leaveTypeUpper = leaveTypeRaw.toUpperCase();
					finalLeaveType = "";

					if(leaveTypeUpper.contains("UNPAID") || leaveTypeUpper.contains("LOP"))
					{
						finalLeaveType = "LOP";
					}
					else if(leaveTypeUpper.contains("SICK") && leaveTypeUpper.contains("CASUAL"))
					{
						if(sickTaken > 0 && casualTaken == 0)
						{
							finalLeaveType = "SL";
						}
						else if(casualTaken > 0 && sickTaken == 0)
						{
							finalLeaveType = "CL";
						}
						else if(sickTaken > 0 && casualTaken > 0)
						{
							if(sickTaken >= casualTaken)
							{
								finalLeaveType = "SL";
							}
							else
							{
								finalLeaveType = "CL";
							}
						}
						else
						{
							finalLeaveType = "CL";
						}
					}
					else if(leaveTypeUpper.contains("SICK"))
					{
						finalLeaveType = "SL";
					}
					else if(leaveTypeUpper.contains("CASUAL"))
					{
						finalLeaveType = "CL";
					}
					else if(leaveTypeUpper.contains("PLANED") || leaveTypeUpper.contains("PLANNED"))
					{
						finalLeaveType = "CL";
					}
					else
					{
						if(sickTaken > 0)
						{
							finalLeaveType = "SL";
						}
						else if(casualTaken > 0)
						{
							finalLeaveType = "CL";
						}
						else
						{
							finalLeaveType = "CL";
						}
					}

					for each di in spanDaysList
					{
						leaveDateObj = fromDate.addDay(di);

						if(leaveDateObj <= toDate && leaveDateObj >= monthStart && leaveDateObj <= monthEnd)
						{
							leaveDates.add(leaveDateObj.toString("yyyy-MM-dd"));
							leaveTypes.add(finalLeaveType);
							leaveBrs.add(br);
						}
					}
				}
			}
		}
	}
	catch(eLeavesAll)
	{
	}

