<body>
<div class="app-shell">

	<div class="top-navbar">
		<div class="brand-wrap">
			<div class="brand-cal-icon">
				<img src="https://cdn-icons-png.flaticon.com/128/833/833593.png" alt="Calendar">
			</div>

			<div>
				<div class="brand-title">Employee Calendar</div>
				<div class="brand-sub">Monthly Attendance & Leave Overview</div>
			</div>
		</div>

		<div class="nav-center">
			<div class="month-nav">
				<a href="#Page:Test_Employee_Calendar?d=<%=baseDate.toString("dd-MMM-yyyy")%>&Next_btn=false&employee_email=<%=input.employee_email%>" class="month-nav-btn">
					<i class="fas fa-chevron-left"></i>
				</a>

				<span class="current-month">
					<i class="far fa-calendar"></i>
					<%=baseDate.toString("MMMM yyyy")%>
				</span>

				<a href="#Page:Test_Employee_Calendar?d=<%=baseDate.toString("dd-MMM-yyyy")%>&Next_btn=true&employee_email=<%=input.employee_email%>" class="month-nav-btn">
					<i class="fas fa-chevron-right"></i>
				</a>
			</div>

			<a href="#Page:Test_Employee_Calendar?d=<%=zoho.currentdate.toString("dd-MMM-yyyy")%>&employee_email=<%=input.employee_email%>" class="today-btn">
				<i class="far fa-calendar"></i>
				Today
			</a>
		</div>
	</div>

<%
	if(input.employee_email == "")
	{
		%>
		<div class="no-employee-msg">
			No employee selected. Add <code>employee_email</code> to the page URL to view a calendar.
		</div>
		<%
	}
	else
	{
		%>

		<div class="content-grid">

			<aside class="profile-card">
				<img src="<%=photoSource%>" class="emp-avatar-lg" alt="<%=ifnull(targetEmpName,"Employee")%>" onerror="this.onerror=null;this.src='<%=fallbackAvatar%>';">
				<div class="profile-name">
					<%=if(targetEmpName == "","No Employee Selected",targetEmpName)%>
				</div>
				<div class="profile-role">
					<%=targetemployeerole%>
				</div>
			</aside>

			<div class="calendar-wrap">
				<div class="calendar-weekday-header">
					<div>Sun</div>
					<div>Mon</div>
					<div>Tue</div>
					<div>Wed</div>
					<div>Thu</div>
					<div>Fri</div>
					<div>Sat</div>
				</div>

<%
				for each weekNum in weekIndexList
				{
					%>
					<div class="calendar-week-row">
<%
					for each dow in dowIndexList
					{
						cellIndex = weekNum * 7 + dow;
						cellDate = gridStart.addDay(cellIndex);

						inMonth = cellDate.toStartOfMonth() == baseDate;
						isWeekendCol = dow == 0 || dow == 6;
						isToday = cellDate.toString("dd-MM-yyyy") == input.t;

						cellClasses = "calendar-day-cell";

						if(isToday && inMonth)
						{
							cellClasses = cellClasses + " today-cell";
						}

						if(!inMonth)
						{
							cellClasses = cellClasses + " empty-cell";
						}

						displayStatus = "";
						badgeClass = "";
						titleText = "";
						hdLinkUrl = "";
						showDash = false;
						uiLabel = "";
						uiLabelDescription = "";
						uiIcon = "";

						if(inMonth)
						{
							isFuture = cellDate > zoho.currentdate;
							dateKey = cellDate.toString("yyyy-MM-dd");

							// ====================================================
							// HOLIDAY CHECK
							// ====================================================
							holidayName = "";
							isHoliday = false;
							holidayIndex = 0;

							for each holidayDateKey in holidayDates
							{
								if(!isHoliday && holidayDateKey == dateKey)
								{
									isHoliday = true;
									holidayName = holidayNames.get(holidayIndex);
								}

								holidayIndex = holidayIndex + 1;
							}

							if(isHoliday)
							{
								displayStatus = "H";
								badgeClass = "status-holiday";
								titleText = holidayName;
								cellClasses = cellClasses + " cell-holiday-bg";
								rowHoliday = rowHoliday + 1;
							}
							else if(isWeekendCol)
							{
								displayStatus = "W";
								badgeClass = "status-w";
								titleText = "Weekend";
							}
							else if(isFuture)
							{
								showDash = true;
							}
							else
							{
								// ====================================================
								// LEAVE CHECK
								// ====================================================
								hasLeave = false;
								leaveType = "";
								brVal = "";
								leaveIndex = 0;

								for each leaveDateKey in leaveDates
								{
									if(!hasLeave && leaveDateKey == dateKey)
									{
										hasLeave = true;
										leaveType = leaveTypes.get(leaveIndex);
										brVal = leaveBrs.get(leaveIndex);
									}

									leaveIndex = leaveIndex + 1;
								}

								isHalfDay = false;
								isFH = false;

								if(hasLeave)
								{
									brLower = ifnull(brVal,"").toLowerCase();

									if(brLower.contains("first half") || brLower.contains("1st") || brLower.contains("fh"))
									{
										isHalfDay = true;
										isFH = true;
									}
									else if(brLower.contains("second half") || brLower.contains("2nd") || brLower.contains("sh") || brLower.contains("half"))
									{
										isHalfDay = true;
									}
								}

								// ====================================================
								// GET CONVERTED FINAL_TIME
								// ====================================================
								finalTimeValue = attendanceTimeMap.get(dateKey);
								hasPunch = finalTimeValue != null;

								workedMinutes = 0;
								finalTimeDisplay = "";

								if(hasPunch)
								{
									workedMinutes = attendanceMinutesMap.get(dateKey);
									finalTimeDisplay = ifnull(attendanceDisplayMap.get(dateKey),"").toString();
								}

								// ====================================================
								// ATTENDANCE STATUS
								// ====================================================
								if(hasPunch)
								{
									// 480 minutes = 8 hours
									if(workedMinutes >= fullDayMinutes)
									{
										displayStatus = "P";
										badgeClass = "status-fd";

										titleText = "Present | Final_Time: " + finalTimeDisplay + " | Worked Minutes: " + workedMinutes;

										rowPresent = rowPresent + 1;
									}
									else if(hasLeave && isHalfDay)
									{
										// 240 minutes = 4 hours
										if(workedMinutes >= halfDayMinutes)
										{
											rowPresent = rowPresent + 0.5;
											rowAbsent = rowAbsent + 0.5;
											rowHalfDay = rowHalfDay + 1;
										}
										else
										{
											rowAbsent = rowAbsent + 1.0;
											rowPureAbsent = rowPureAbsent + 0.5;
										}

										leaveIncrement = 0.5;

										if(leaveType == "SL")
										{
											displayStatus = if(isFH,"SL 1st","SL 2nd");
											badgeClass = if(isFH,"status-sl1","status-sl2");
											rowSL = rowSL + leaveIncrement;
										}
										else if(leaveType == "LOP")
										{
											displayStatus = if(isFH,"LOP 1st","LOP 2nd");
											badgeClass = if(isFH,"status-lop1","status-lop2");
											rowLOP = rowLOP + leaveIncrement;
										}
										else
										{
											displayStatus = if(isFH,"CL 1st","CL 2nd");
											badgeClass = if(isFH,"status-cl1","status-cl2");
											rowCL = rowCL + leaveIncrement;
										}

										titleText = displayStatus + " + Worked | Final_Time: " + finalTimeDisplay + " | Worked Minutes: " + workedMinutes;
									}
									else if(hasLeave && !isHalfDay)
									{
										rowAbsent = rowAbsent + 1.0;

										if(leaveType == "SL")
										{
											displayStatus = "SL";
											badgeClass = "status-leave-sick";
											rowSL = rowSL + 1.0;
										}
										else if(leaveType == "LOP")
										{
											displayStatus = "LOP";
											badgeClass = "status-lop";
											rowLOP = rowLOP + 1.0;
										}
										else
										{
											displayStatus = "CL";
											badgeClass = "status-leave-casual";
											rowCL = rowCL + 1.0;
										}

										titleText = displayStatus + " Full Day Leave | Final_Time: " + finalTimeDisplay + " | Worked Minutes: " + workedMinutes;
									}
									else
									{
										if(isToday)
										{
											displayStatus = "";
											badgeClass = "";

											titleText = "Today in progress | Final_Time: " + finalTimeDisplay + " | Worked Minutes: " + workedMinutes;
										}
										else
										{
											if(workedMinutes >= halfDayMinutes)
											{
												rowPresent = rowPresent + 0.5;
												rowAbsent = rowAbsent + 0.5;
												rowHalfDay = rowHalfDay + 1;
											}
											else
											{
												rowAbsent = rowAbsent + 1.0;
												rowPureAbsent = rowPureAbsent + 1.0;
											}

											dateFormatted = cellDate.toString("dd-MMM-yyyy");

											hdLinkUrl = "https://creatorapp.zohopublic.in/zentegraindia/attendance-payroll-management/form-embed/Attendance_Regularization/rQKJJr5sVeFsDKXuynymhz0S9PxeZ39jPhY4vTjfXPRKwkPh8unh8pWQUEeBumqarGzCwqGhNxxFQ3ZpP4n8jqTTgfpVJwweN91G?&Employee=" + targetEmpID + "&Date_field=" + dateFormatted;

											displayStatus = "SH";
											badgeClass = "status-sh";

											titleText = "Short Hours | Final_Time: " + finalTimeDisplay + " | Worked Minutes: " + workedMinutes + " | Click to regularize";
										}
									}
								}
								else if(hasLeave)
								{
									if(isHalfDay)
									{
										rowAbsent = rowAbsent + 1.0;
										rowPureAbsent = rowPureAbsent + 0.5;
										leaveIncrement = 0.5;

										if(leaveType == "SL")
										{
											displayStatus = if(isFH,"SL 1st","SL 2nd");
											badgeClass = if(isFH,"status-sl1","status-sl2");
											rowSL = rowSL + leaveIncrement;
										}
										else if(leaveType == "LOP")
										{
											displayStatus = if(isFH,"LOP 1st","LOP 2nd");
											badgeClass = if(isFH,"status-lop1","status-lop2");
											rowLOP = rowLOP + leaveIncrement;
										}
										else
										{
											displayStatus = if(isFH,"CL 1st","CL 2nd");
											badgeClass = if(isFH,"status-cl1","status-cl2");
											rowCL = rowCL + leaveIncrement;
										}

										titleText = displayStatus + " + Absent";
									}
									else
									{
										rowAbsent = rowAbsent + 1.0;

										if(leaveType == "SL")
										{
											displayStatus = "SL";
											badgeClass = "status-leave-sick";
											rowSL = rowSL + 1.0;
										}
										else if(leaveType == "LOP")
										{
											displayStatus = "LOP";
											badgeClass = "status-lop";
											rowLOP = rowLOP + 1.0;
										}
										else
										{
											displayStatus = "CL";
											badgeClass = "status-leave-casual";
											rowCL = rowCL + 1.0;
										}

										titleText = displayStatus + " Full Day Leave";
									}
								}
								else
								{
									if(isToday)
									{
										displayStatus = "";
										badgeClass = "";
										titleText = "Today";
									}
									else
									{
										displayStatus = "A";
										badgeClass = "status-absent";
										titleText = "Absent";

										rowAbsent = rowAbsent + 1.0;
										rowPureAbsent = rowPureAbsent + 1.0;
									}
								}
							}

							// ====================================================
							// UI LABELS
							// ====================================================
							if(displayStatus == "P")
							{
								uiLabel = "Present";
								uiIcon = "fas fa-circle";
								cellClasses = cellClasses + " cell-present-bg";
							}
							else if(displayStatus == "SH")
							{
								uiLabel = "Short Hours";
								uiLabelDescription = "Click to Request Regularization";
								uiIcon = "fas fa-clock";
								cellClasses = cellClasses + " cell-sh-bg";
							}
							else if(displayStatus == "A")
							{
								uiLabel = "Absent";
								uiIcon = "fas fa-user-xmark";
								cellClasses = cellClasses + " cell-absent-bg";
							}
							else if(displayStatus == "H")
							{
								uiLabel = "Holiday";
								uiIcon = "fas fa-umbrella-beach";
								cellClasses = cellClasses + " cell-holiday-bg";
							}
							else if(displayStatus == "CL")
							{
								uiLabel = "Casual Leave";
								uiIcon = "fas fa-briefcase";
								cellClasses = cellClasses + " cell-cl-bg";
							}
							else if(displayStatus == "CL 1st")
							{
								uiLabel = "CL 1st Half";
								uiIcon = "fas fa-briefcase";
								cellClasses = cellClasses + " cell-cl-bg";
							}
							else if(displayStatus == "CL 2nd")
							{
								uiLabel = "CL 2nd Half";
								uiIcon = "fas fa-briefcase";
								cellClasses = cellClasses + " cell-cl-bg";
							}
							else if(displayStatus == "SL")
							{
								uiLabel = "Sick Leave";
								uiIcon = "fas fa-briefcase";
								cellClasses = cellClasses + " cell-sl-bg";
							}
							else if(displayStatus == "SL 1st")
							{
								uiLabel = "SL 1st Half";
								uiIcon = "fas fa-briefcase";
								cellClasses = cellClasses + " cell-sl-bg";
							}
							else if(displayStatus == "SL 2nd")
							{
								uiLabel = "SL 2nd Half";
								uiIcon = "fas fa-briefcase";
								cellClasses = cellClasses + " cell-sl-bg";
							}
							else if(displayStatus == "LOP")
							{
								uiLabel = "LOP";
								uiIcon = "fas fa-ban";
								cellClasses = cellClasses + " cell-lop-bg";
							}
							else if(displayStatus == "LOP 1st")
							{
								uiLabel = "LOP 1st Half";
								uiIcon = "fas fa-ban";
								cellClasses = cellClasses + " cell-lop-bg";
							}
							else if(displayStatus == "LOP 2nd")
							{
								uiLabel = "LOP 2nd Half";
								uiIcon = "fas fa-ban";
								cellClasses = cellClasses + " cell-lop-bg";
							}
							else if(displayStatus == "W")
							{
								uiLabel = "Week Off";
								uiIcon = "fas fa-mug-hot";
							}
						}

						dayNumClass = "day-number";

						if(inMonth)
						{
							if(dow == 0)
							{
								dayNumClass = dayNumClass + " sun-num";
							}

							if(dow == 6)
							{
								dayNumClass = dayNumClass + " sat-num";
							}
						}
						%>

						<div class="<%=cellClasses%>" title="<%=titleText%>">
							<div class="<%=dayNumClass%>">
								<%=cellDate.toString("dd")%>
							</div>

<%
						if(inMonth)
						{
							%>
							<div class="cell-status">
<%
							if(showDash)
							{
								%>
								<span class="text-muted" style="opacity:0.35;font-weight:600;font-size:16px;">
									&mdash;
								</span>
								<%
							}
							else if(uiLabel != "")
							{
								if(hdLinkUrl != "")
								{
									shId = "sh_" + cellDate.toString("yyyyMMdd");
									%>

									<input type="checkbox" id="<%=shId%>" class="sh-toggle">

									<label for="<%=shId%>" class="hd-link" title="<%=titleText%>">
										<span class="status-badge <%=badgeClass%>">
											<i class="<%=uiIcon%>"></i>
											<%=uiLabel%>
										</span>
										<br>
										<span class="desp">
											<%=uiLabelDescription%>
										</span>
									</label>

									<div class="sh-modal-overlay">
										<label for="<%=shId%>" class="sh-backdrop"></label>

										<div class="sh-modal-box">
											<div class="sh-modal-header">
												<div>
													<div class="sh-modal-title">
														<i class="fas fa-clock"></i>
														Attendance Regularization Request
													</div>

													<div class="sh-modal-sub">
														This Request Goes To Your Reporting Manager &amp; HR
													</div>
												</div>

												<label for="<%=shId%>" class="sh-modal-close">
													<i class="fas fa-times"></i>
												</label>
											</div>

											<div class="sh-modal-body">
												<iframe src="<%=hdLinkUrl%>" loading="lazy" frameborder="0" allowTransparency="true" scrolling="auto"></iframe>
											</div>
										</div>
									</div>

									<%
								}
								else
								{
									%>

									<span class="status-badge <%=badgeClass%>" title="<%=titleText%>">
										<i class="<%=uiIcon%>"></i>
										<%=uiLabel%>
									</span>

									<%
								}
							}
							%>
							</div>
							<%
						}
						%>
						</div>

						<%
					}
					%>
					</div>
					<%
				}
				%>
			</div>

			<aside class="leave-summary-card">
				<div class="leave-summary-title">
					<img class="leave-sum-icon" src="https://cdn-icons-png.flaticon.com/128/16916/16916358.png" alt="">
					Leave Summary
				</div>

				<div class="leave-grid">
					<div class="leave-tile tile-present">
						<div class="ico"><i class="fas fa-circle-check"></i></div>
						<span class="lbl">Present Days</span>
						<span class="val"><%=rowPresent%></span>
					</div>

					<div class="leave-tile tile-taken">
						<div class="ico"><i class="fas fa-calendar-day"></i></div>
						<span class="lbl">Total Leave Taken</span>
						<span class="val"><%=rowAbsent%></span>
					</div>

					<div class="leave-tile tile-sl">
						<div class="ico"><i class="fas fa-notes-medical"></i></div>
						<span class="lbl">Sick Leave Taken</span>
						<span class="val"><%=rowSL%></span>
					</div>

					<div class="leave-tile tile-cl">
						<div class="ico"><i class="fas fa-leaf"></i></div>
						<span class="lbl">Casual Leave Taken</span>
						<span class="val"><%=rowCL%></span>
					</div>

					<div class="leave-tile tile-lop">
						<div class="ico"><i class="fas fa-ban"></i></div>
						<span class="lbl">LOP</span>
						<span class="val"><%=rowLOP%></span>
					</div>

					<div class="leave-tile tile-half">
						<div class="ico"><i class="fas fa-clock"></i></div>
						<span class="lbl">Half Days Taken<br>(Less than 8hrs)</span>
						<span class="val"><%=rowHalfDay%></span>
					</div>
				</div>

				<div class="tile-holiday-wide">
					<div class="ico">
						<i class="fas fa-umbrella-beach"></i>
					</div>

					<div>
						<span class="lbl">Holiday</span>
						<span class="val"><%=rowHoliday%></span>
					</div>
				</div>
			</aside>

			<div class="legend-row">
				<span class="legend-item">
					<span class="legend-dot dot-p"></span> Present
				</span>

				<span class="legend-item">
					<span class="legend-dot dot-h"></span> Short Hours
				</span>

				<span class="legend-item">
					<span class="legend-dot dot-cl"></span> Casual Leave
				</span>

				<span class="legend-item">
					<span class="legend-dot dot-sl"></span> Sick Leave
				</span>

				<span class="legend-item">
					<span class="legend-dot dot-lop"></span> LOP
				</span>

				<span class="legend-item">
					<span class="legend-dot dot-a"></span> Absent
				</span>

				<span class="legend-item">
					<span class="legend-dot dot-hol"></span> Holiday
				</span>
			</div>

		</div>

		<%
	}
	%>

</div>
</body>
</html>
<%
}%>
