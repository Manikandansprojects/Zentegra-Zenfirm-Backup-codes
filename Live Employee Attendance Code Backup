<%
		for each  weekNum in weekIndexList
		{
			%>
<div class="calendar-week-row">
<%
			for each  dow in dowIndexList
			{
				cellIndex = weekNum * 7 + dow;
				cellDate = gridStart.addDay(cellIndex);
				inMonth = cellDate.toStartOfMonth() == baseDate;
				isWeekendCol = dow == 0 || dow == 6;
				isToday = cellDate.toString("dd-MM-yyyy") == input.t;
				cellClasses = "calendar-day-cell";
				if(isToday && inMonth)
				{
					cellClasses = cellClasses + " today-cell";
				}
				if(!inMonth)
				{
					cellClasses = cellClasses + " empty-cell";
				}
				displayStatus = "";
				badgeClass = "";
				titleText = "";
				hdLinkUrl = "";
				showDash = false;
				uiLabel = "";
				uiLabelDescription = "";
				uiIcon = "";
				uiLabel2 = "";
				badgeClass2 = "";
				uiIcon2 = "";
				isSplitDisplay = false;
				descClass = "";
				finalTimeDisplay = "";
				liveTimeDisplay = "";
				punchTableFull = "";
				statusWrapClass = "cell-status";
				if(inMonth)
				{
					isFuture = cellDate > zoho.currentdate;
					dateKey = cellDate.toString("yyyy-MM-dd");
					holidayName = "";
					isHoliday = false;
					holidayIndex = 0;
					for each  holidayDateKey in holidayDates
					{
						if(!isHoliday && holidayDateKey == dateKey)
						{
							isHoliday = true;
							holidayName = holidayNames.get(holidayIndex);
						}
						holidayIndex = holidayIndex + 1;
					}
					if(isHoliday)
					{
						displayStatus = "H";
