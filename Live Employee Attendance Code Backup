	// ============================================================
	// LEAVES
	// Store First Half, Second Half and Full Day separately
	// so the same date can have CL 1st + SL 2nd
	// ============================================================
	leaveFullMap = Map();
	leaveFHMap = Map();
	leaveSHMap = Map();
	try 
	{
		for each  leaveEntry in Request_Leave[Approval_status == "Approved"]
		{
			leaveEmployeeEmail = "";
			leaveEmployeeName = "";
			leaveEmployeeID = "";
			try 
			{
				leaveEmployeeEmail = ifnull(leaveEntry.Employee_Name.Email,"").toString().trim();
			}			catch (eLeaveEmail)
			{
				leaveEmployeeEmail = "";
			}
			try 
			{
				leaveEmployeeName = ifnull(leaveEntry.Employee_Name.Name,"").toString().trim();
			}			catch (eLeaveName)
			{
				leaveEmployeeName = "";
			}
			try 
			{
				leaveEmployeeID = ifnull(leaveEntry.Employee_Name.ID,"").toString().trim();
			}			catch (eLeaveID)
			{
				leaveEmployeeID = "";
			}
			leaveMatches = false;
			if(leaveEmployeeEmail != "" && input.employee_email != "" && leaveEmployeeEmail.toLowerCase() == input.employee_email.toLowerCase())
			{
				leaveMatches = true;
			}
			if(!leaveMatches && leaveEmployeeID != "" && targetEmpID != null && targetEmpID.toString() != "" && leaveEmployeeID == targetEmpID.toString())
			{
				leaveMatches = true;
			}
			if(!leaveMatches && leaveEmployeeName != "" && targetEmpName != "")
			{
				if(leaveEmployeeName.toLowerCase() == targetEmpName.toLowerCase())
				{
					leaveMatches = true;
				}
			}
			if(!leaveMatches)
			{
				continue;
			}
			parentFrom = null;
			parentTo = null;
			try 
			{
				parentFrom = leaveEntry.From;
			}			catch (eParentFrom)
			{
				parentFrom = null;
			}
			try 
			{
				parentTo = leaveEntry.To;
			}			catch (eParentTo)
			{
				parentTo = null;
			}
			if(parentFrom != null && parentTo != null)
			{
				if(parentTo < monthStart || parentFrom > monthEnd)
				{
					continue;
				}
			}
			for each  detail in leaveEntry.Leave_Days_Details
			{
				leaveDateObj = null;
				try 
				{
					leaveDateObj = detail.Date_field;
				}				catch (eSubDate1)
				{
					leaveDateObj = null;
				}
				if(leaveDateObj == null)
				{
					try 
					{
						leaveDateObj = detail.Date_field;
					}					catch (eSubDate2)
					{
						leaveDateObj = null;
					}
				}
				if(leaveDateObj == null)
				{
					continue;
				}
				if(leaveDateObj < monthStart || leaveDateObj > monthEnd)
				{
					continue;
				}
				leaveTypeRaw = "";
				try 
				{
					leaveTypeRaw = ifnull(detail.Leave_Type.Leave_Type,"").toString().trim();
				}				catch (eSubType1)
				{
					leaveTypeRaw = "";
				}
				if(leaveTypeRaw == "")
				{
					try 
					{
						leaveTypeRaw = ifnull(detail.Leave_Type,"").toString().trim();
					}					catch (eSubType2)
					{
						leaveTypeRaw = "";
					}
				}
				leaveTypeUpper = leaveTypeRaw.toUpperCase();
				finalLeaveType = "CL";
				if(leaveTypeUpper.contains("SICK"))
				{
					finalLeaveType = "SL";
				}
				else if(leaveTypeUpper.contains("LOP") || leaveTypeUpper.contains("UNPAID"))
				{
					finalLeaveType = "LOP";
				}
				else if(leaveTypeUpper.contains("CASUAL") || leaveTypeUpper.contains("PLANED") || leaveTypeUpper.contains("PLANNED"))
				{
					finalLeaveType = "CL";
				}
				dayTypeStr = "";
				brVal = "";
				try 
				{
					dayTypeStr = ifnull(detail.br,"").toString().trim();
				}				catch (eSubBr)
				{
					dayTypeStr = "";
				}
				dayTypeLower = dayTypeStr.toLowerCase();
				if(dayTypeLower.contains("first half") || dayTypeLower.contains("1st half") || dayTypeLower.contains("1st") || dayTypeLower == "fh" || dayTypeLower.contains("fh"))
				{
					brVal = "FH";
				}
				else if(dayTypeLower.contains("second half") || dayTypeLower.contains("2nd half") || dayTypeLower.contains("2nd") || dayTypeLower == "sh" || dayTypeLower.contains("sh"))
				{
					brVal = "SH";
				}
				else if(dayTypeLower.contains("half"))
				{
					brVal = "half";
				}
				else
				{
					brVal = "";
				}
				leaveDateKey = leaveDateObj.toString("yyyy-MM-dd");
				leaveInfo = Map();
				leaveInfo.put("leave_type",finalLeaveType);
				leaveInfo.put("day_type",dayTypeStr);
				leaveInfo.put("employee_id",targetEmpID);
				leaveInfo.put("br",brVal);
				leaveInfo.put("raw_leave_type",leaveTypeRaw);
				if(brVal == "FH")
				{
					leaveFHMap.put(leaveDateKey,leaveInfo);
				}
				else if(brVal == "SH")
				{
					leaveSHMap.put(leaveDateKey,leaveInfo);
				}
				else if(brVal == "half")
				{
					if(leaveFHMap.get(leaveDateKey) == null)
					{
						leaveFHMap.put(leaveDateKey,leaveInfo);
					}
					else
					{
						leaveSHMap.put(leaveDateKey,leaveInfo);
					}
				}
				else
				{
					leaveFullMap.put(leaveDateKey,leaveInfo);
				}
			}
		}
	}	catch (eLeavesAll)
	{
	}
