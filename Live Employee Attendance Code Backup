				<span class="legend-item"><span class="legend-dot dot-cl"></span> Casual Leave</span>
				<span class="legend-item"><span class="legend-dot dot-sl"></span> Sick Leave</span>
				<span class="legend-item"><span class="legend-dot dot-lop"></span> LOP</span>
				<span class="legend-item"><span class="legend-dot dot-a"></span> Absent</span>
				<span class="legend-item"><span class="legend-dot dot-hol"></span> Holiday</span>
			</div>

		</div>
<%
	}
	%>
</div>
