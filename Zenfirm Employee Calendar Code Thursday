					{
						recDate = rec.get("Date");
						hrsRaw = rec.get("Hoursworked");
						if(recDate != null && hrsRaw != null)
						{
							gotDate = false;
							try 
							{
								recDateObj = recDate.toDate("yyyy-MM-dd");
								gotDate = true;
							}
							catch (e1)
							{
								try 
								{
									recDateObj = recDate.toDate("dd-MMM-yyyy");
									gotDate = true;
								}
								catch (e2)
								{
									try 
									{
										recDateObj = recDate.toDate("dd-MM-yyyy");
										gotDate = true;
									}
									catch (e3)
									{
										try 
										{
											recDateObj = recDate.toDate("MM-dd-yyyy");
											gotDate = true;
										}
										catch (e4)
										{
											try 
											{
												yy = recDate.getYear();
												recDateObj = recDate;
												gotDate = true;
											}
											catch (e5)
											{
											}
										}
									}
								}
							}
							if(gotDate)
							{
								if(recDateObj >= monthStart && recDateObj <= monthEnd)
								{
									attendanceMap.put(recDateObj.toString("yyyy-MM-dd"),hrsRaw);
								}
							}
						}
					}
				}
			}
		}
	}
	catch (e)
	{
	}
	// ============================================================
	// HOLIDAYS
	// ============================================================
	holidayDates = List();
	holidayNames = List();
	try 
	{
		for each  hRec in Holiday_Calendar[Date_field >= monthStart && Date_field <= monthEnd]
		{
			if(hRec.Date_field != null)
			{
				hName = "Holiday";
				try 
				{
					hName = ifnull(hRec.Event_Name,"Holiday");
				}
				catch (eN3)
				{
				}
				holidayDates.add(hRec.Date_field.toString("yyyy-MM-dd"));
				holidayNames.add(hName);
			}
		}
	}
	catch (e)
	{
	}
	// ============================================================
	// LEAVES — Request_Leave
	// Leave_Type is a PARENT field. Do not read it from Leave_Days_Details.
	// ============================================================
	leaveDates = List();
	leaveTypes = List();
	leaveBrs = List();
	fetchedLeaves = false;
	if(input.employee_email != "")
	{
		try 
		{
			for each  leaveEntry in Request_Leave[Employee_Name.Email == input.employee_email && Approval_status == "Approved"]
			{
				fetchedLeaves = true;
				fromDate = null;
				toDate = null;
				try
				{
					fromDate = leaveEntry.From;
				}
				catch (eF1)
				{
				}
				try
				{
					toDate = leaveEntry.To;
				}
				catch (eT1)
				{
				}
				if(fromDate == null)
				{
					continue;
				}
				if(toDate == null)
				{
					toDate = fromDate;
				}
				// PARENT FIELD — this is the fix
				leaveTypeRaw = "";
				try
				{
					leaveTypeRaw = ifnull(leaveEntry.Leave_Days_Details.Leave_Type.Leave_Type,"").toString();
				}
				catch (eL1)
				{
					leaveTypeRaw = "";
				}
				sickTaken = 0.0;
				try
				{
					sickTaken = ifnull(leaveEntry.Sick_Taken,0).toString().toDecimal();
				}
				catch (eS1)
				{
					sickTaken = 0.0;
				}
				casualTaken = 0.0;
				try
				{
					casualTaken = ifnull(leaveEntry.Casual_Taken,0).toString().toDecimal();
				}
				catch (eC1)
				{
					casualTaken = 0.0;
				}
				noOfDaysLeave = 0.0;
				try
				{
					noOfDaysLeave = ifnull(leaveEntry.No_Of_Days_Leave,0).toString().toDecimal();
				}
				catch (eN1)
				{
					noOfDaysLeave = 0.0;
				}
				br = "";
				try
				{
					commentText = ifnull(leaveEntry.Comments,"").toString().toLowerCase();
					if(commentText.contains("first half") || commentText.contains("1st half"))
					{
						br = "FH";
					}
					else if(commentText.contains("second half") || commentText.contains("2nd half"))
					{
						br = "SH";
					}
				}
				catch (eB1)
				{
					br = "";
				}
				if(br == "" && noOfDaysLeave == 0.5)
				{
					br = "half";
				}
				leaveTypeUpper = leaveTypeRaw.toUpperCase();
				finalLeaveType = "";
				if(leaveTypeUpper.contains("UNPAID") || leaveTypeUpper.contains("LOP"))
				{
					finalLeaveType = "LOP";
				}
				else if(leaveTypeUpper.contains("SICK") && leaveTypeUpper.contains("CASUAL"))
				{
					if(sickTaken > 0 && casualTaken == 0)
					{
						finalLeaveType = "SL";
					}
					else if(casualTaken > 0 && sickTaken == 0)
					{
						finalLeaveType = "CL";
					}
					else if(sickTaken > 0 && casualTaken > 0)
					{
						if(sickTaken >= casualTaken)
						{
							finalLeaveType = "SL";
						}
						else
						{
							finalLeaveType = "CL";
						}
					}
					else
					{
						finalLeaveType = "CL";
					}
				}
				else if(leaveTypeUpper.contains("SICK"))
				{
					finalLeaveType = "SL";
				}
				else if(leaveTypeUpper.contains("CASUAL"))
				{
					finalLeaveType = "CL";
				}
				else if(leaveTypeUpper.contains("PLANED") || leaveTypeUpper.contains("PLANNED"))
				{
					finalLeaveType = "CL";
				}
				else
				{
					if(sickTaken > 0)
					{
						finalLeaveType = "SL";
					}
					else if(casualTaken > 0)
					{
						finalLeaveType = "CL";
					}
					else
					{
						finalLeaveType = "CL";
					}
				}
				for each  di in spanDaysList
				{
					leaveDateObj = fromDate.addDay(di);
					if(leaveDateObj > toDate)
					{
						continue;
					}
					if(leaveDateObj >= monthStart && leaveDateObj <= monthEnd)
					{
						leaveDates.add(leaveDateObj.toString("yyyy-MM-dd"));
						leaveTypes.add(finalLeaveType);
						leaveBrs.add(br);
					}
				}
			}
		}
		catch (eEmail)
		{
		}
		// Fallback by Name if the Email lookup returned nothing
		if(!fetchedLeaves && targetEmpName != "" && targetEmpName != input.employee_email)
		{
			try 
			{
				for each  leaveEntry in Request_Leave[Employee_Name.Name == targetEmpName && Approval_status == "Approved"]
				{
					fromDate = null;
					toDate = null;
					try
					{
						fromDate = leaveEntry.From;
					}
					catch (eFN)
					{
					}
					try
					{
						toDate = leaveEntry.To;
					}
					catch (eTN)
					{
					}
					if(fromDate == null)
					{
						continue;
					}
					if(toDate == null)
					{
						toDate = fromDate;
					}
					// PARENT FIELD — this is the fix
					leaveTypeRaw = "";
					try
					{
						leaveTypeRaw = ifnull(leaveEntry.Leave_Days_Details.Leave_Type.Leave_Type,"").toString();
					}
					catch (eLN)
					{
						leaveTypeRaw = "";
					}
					sickTaken = 0.0;
					try
					{
						sickTaken = ifnull(leaveEntry.Sick_Taken,0).toString().toDecimal();
					}
					catch (eSN)
					{
						sickTaken = 0.0;
					}
					casualTaken = 0.0;
					try
					{
						casualTaken = ifnull(leaveEntry.Casual_Taken,0).toString().toDecimal();
					}
					catch (eCN)
					{
						casualTaken = 0.0;
					}
					noOfDaysLeave = 0.0;
					try
					{
						noOfDaysLeave = ifnull(leaveEntry.No_Of_Days_Leave,0).toString().toDecimal();
					}
					catch (eNN)
					{
						noOfDaysLeave = 0.0;
					}
					br = "";
					try
					{
						commentText = ifnull(leaveEntry.Comments,"").toString().toLowerCase();
						if(commentText.contains("first half") || commentText.contains("1st half"))
						{
							br = "FH";
						}
						else if(commentText.contains("second half") || commentText.contains("2nd half"))
						{
							br = "SH";
						}
					}
					catch (eBN)
					{
						br = "";
					}
					if(br == "" && noOfDaysLeave == 0.5)
					{
						br = "half";
					}
					leaveTypeUpper = leaveTypeRaw.toUpperCase();
					finalLeaveType = "";
					if(leaveTypeUpper.contains("UNPAID") || leaveTypeUpper.contains("LOP"))
					{
						finalLeaveType = "LOP";
					}
					else if(leaveTypeUpper.contains("SICK") && leaveTypeUpper.contains("CASUAL"))
					{
						if(sickTaken > 0 && casualTaken == 0)
						{
							finalLeaveType = "SL";
						}
