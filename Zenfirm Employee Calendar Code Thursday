                    <a href="#Page:Test_Page?d=<%=baseDate.toString("dd-MMM-yyyy")%>&Next_btn=false&employee_email=<%=input.employee_email%>" class="month-nav-btn"><i class="fas fa-chevron-left"></i></a>
                    <span class="current-month"><%=baseDate.toString("MMMM yyyy")%></span>
                    <a href="#Page:Test_Page?d=<%=baseDate.toString("dd-MMM-yyyy")%>&Next_btn=true&employee_email=<%=input.employee_email%>" class="month-nav-btn"><i class="fas fa-chevron-right"></i></a>
                </div>
            </div>
        </nav>

        <div class="legend-bar">
            <div class="legend-item"><span class="legend-chip status-fd">P</span>Full Day Present (&ge; 8 Hrs)</div>
            <div class="legend-item"><span class="legend-chip status-hd">SH</span>Short Hours (&lt; 8 Hrs)</div>
            <div class="legend-item"><span class="legend-chip status-absent">A</span>Absent (0 Hrs)</div>
            <div class="legend-item"><span class="legend-chip status-holiday">H</span>Holiday</div>
            <div class="legend-item"><span class="legend-chip status-leave-casual">CL</span>CL Full</div>
            <div class="legend-item"><span class="legend-chip status-cl1">CL 1st</span>CL 1st Half</div>
            <div class="legend-item"><span class="legend-chip status-cl2">CL 2nd</span>CL 2nd Half</div>
            <div class="legend-item"><span class="legend-chip status-leave-sick">SL</span>Sick Leave Full</div>
            <div class="legend-item"><span class="legend-chip status-sl1">SL 1st</span>Sick Leave 1st Half</div>
            <div class="legend-item"><span class="legend-chip status-sl2">SL 2nd</span>Sick Leave 2nd Half</div>
            <div class="legend-item"><span class="legend-chip status-lop1">LOP 1st</span>LOP 1st Half</div>
            <div class="legend-item"><span class="legend-chip status-lop2">LOP 2nd</span>LOP 2nd Half</div>
            <div class="legend-item"><span class="legend-chip status-lop">LOP</span>LOP Full Day</div>
            <div class="legend-item"><span class="text-muted" style="margin-right:4px; font-weight:bold;">&mdash;</span>Future Dates</div>
        </div>
    </div>
<%
	if(input.employee_email == "")
	{
		%>
<div class="no-employee-msg">No employee selected. Add <code>employee_email</code> to the page URL to view a calendar.</div>
<%
	}
	else
	{
		%>
    <div class="calendar-container">

        <div class="calendar-weekday-header">
            <div class="weekend-head">SUN</div>
            <div>MON</div><div>TUE</div><div>WED</div><div>THU</div><div>FRI</div>
            <div class="weekend-head">SAT</div>
        </div>
<%
		for each  weekNum in weekIndexList
		{
			%>
<div class="calendar-week-row">
<%
			for each  dow in dowIndexList
			{
				cellIndex = weekNum * 7 + dow;
				cellDate = gridStart.addDay(cellIndex);
				inMonth = cellDate.toStartOfMonth() == baseDate;
				isWeekendCol = dow == 0 || dow == 6;
				isToday = cellDate.toString("dd-MM-yyyy") == input.t;
				cellClasses = "";
				if(isWeekendCol)
				{
					cellClasses = cellClasses + " weekend-col";
				}
				if(isToday && inMonth)
				{
					cellClasses = cellClasses + " today-cell";
				}
				if(!inMonth)
				{
					cellClasses = cellClasses + " empty-cell";
				}
				displayStatus = "";
				badgeClass = "";
				titleText = "";
				hdLinkUrl = "";
				showDash = false;
				if(inMonth)
				{
					isFuture = cellDate > today;
					dateKey = cellDate.toString("yyyy-MM-dd");
					if(isWeekendCol)
					{
						displayStatus = "W";
						badgeClass = "status-w";
						titleText = "Weekend";
					}
					else if(isFuture)
					{
						showDash = true;
					}
					else
					{
						hasLeave = false;
						leaveType = "";
						brVal = "";
						li = 0;
						for each  ld in leaveDates
						{
							if(!hasLeave)
							{
								if(ld == dateKey)
								{
									hasLeave = true;
									leaveType = leaveTypes.get(li);
									brVal = leaveBrs.get(li);
								}
							}
							li = li + 1;
						}
						isHalfDay = false;
						isFH = false;
						if(hasLeave)
						{
							brLower = ifnull(brVal,"").toLowerCase();
							if(brLower.contains("first half") || brLower.contains("1st") || brLower.contains("fh"))
							{
								isHalfDay = true;
								isFH = true;
							}
							else if(brLower.contains("second half") || brLower.contains("2nd") || brLower.contains("sh") || brLower.contains("half"))
							{
								isHalfDay = true;
							}
						}
						hrsVal = attendanceMap.get(dateKey);
						hasPunch = hrsVal != null;
						hoursWorked = 0.0;
						if(hasPunch)
						{
							try 
							{
								hoursWorked = hrsVal.toDecimal();
							}
							catch (eHrs)
							{
								try 
								{
									hoursWorked = hrsVal;
								}
								catch (eHrs2)
								{
									hoursWorked = 0.0;
								}
							}
						}
						holidayName = "";
						isHoliday = false;
						hi = 0;
						for each  hd in holidayDates
						{
							if(!isHoliday)
							{
								if(hd == dateKey)
								{
									isHoliday = true;
									holidayName = holidayNames.get(hi);
								}
							}
							hi = hi + 1;
						}
						if(hasPunch)
						{
							if(hoursWorked >= 8.0)
							{
								displayStatus = "P";
								badgeClass = "status-fd";
								titleText = "Full Day Present (" + hoursWorked + " hrs)";
								cellClasses = cellClasses + " cell-present";
								rowPresent = rowPresent + 1;
							}
							else if(hasLeave && isHalfDay)
							{
								if(hoursWorked >= 4.0)
								{
									rowPresent = rowPresent + 0.5;
									rowAbsent = rowAbsent + 0.5;
									rowHalfDay = rowHalfDay + 1;
								}
								else
								{
									rowAbsent = rowAbsent + 1.0;
									rowPureAbsent = rowPureAbsent + 0.5;
								}
								leaveIncrement = 0.5;
								if(leaveType == "SL")
								{
									displayStatus = if(isFH,"SL 1st","SL 2nd");
									badgeClass = if(isFH,"status-sl1","status-sl2");
									cellClasses = cellClasses + " cell-sl";
									rowSL = rowSL + leaveIncrement;
								}
								else if(leaveType == "LOP")
								{
									displayStatus = if(isFH,"LOP 1st","LOP 2nd");
									badgeClass = if(isFH,"status-lop1","status-lop2");
									cellClasses = cellClasses + " cell-lop";
									rowLOP = rowLOP + leaveIncrement;
								}
								else
								{
									displayStatus = if(isFH,"CL 1st","CL 2nd");
									badgeClass = if(isFH,"status-cl1","status-cl2");
									cellClasses = cellClasses + " cell-cl";
									rowCL = rowCL + leaveIncrement;
								}
								titleText = displayStatus + " + Worked (" + hoursWorked + " hrs)";
							}
							else if(hasLeave && !isHalfDay)
							{
								rowAbsent = rowAbsent + 1.0;
								if(leaveType == "SL")
								{
									displayStatus = "SL";
									badgeClass = "status-leave-sick";
									cellClasses = cellClasses + " cell-sl";
									rowSL = rowSL + 1.0;
								}
								else if(leaveType == "LOP")
								{
									displayStatus = "LOP";
									badgeClass = "status-lop";
									cellClasses = cellClasses + " cell-lop";
									rowLOP = rowLOP + 1.0;
								}
								else
								{
									displayStatus = "CL";
									badgeClass = "status-leave-casual";
									cellClasses = cellClasses + " cell-cl";
									rowCL = rowCL + 1.0;
								}
								titleText = displayStatus + " Full Day Leave (Worked " + hoursWorked + " hrs)";
							}
							else
							{
								if(hoursWorked >= 4.0)
								{
									rowPresent = rowPresent + 0.5;
									rowAbsent = rowAbsent + 0.5;
									rowHalfDay = rowHalfDay + 1;
								}
								else
								{
									rowAbsent = rowAbsent + 1.0;
									rowPureAbsent = rowPureAbsent + 1.0;
								}
								dateFormatted = cellDate.toString("dd-MMM-yyyy");
								hdLinkUrl = "#Form:Attendance_Regularization?zc_LoadIn=dialog&Employee=" + targetEmpID + "&Date_field=" + dateFormatted + "&From_Time=" + "&zc_DialogWidth=900&zc_DialogHeight=700&zc_DialogTop=250&zc_DialogLeft=200";
								displayStatus = "SH";
								badgeClass = "status-hd";
								cellClasses = cellClasses + " cell-sh";
								titleText = "Short Hours - " + targetEmpName + " on " + dateFormatted + " (" + hoursWorked + " hrs) - Click to view report";
							}
						}
						else if(hasLeave)
						{
							if(isHalfDay)
							{
								rowAbsent = rowAbsent + 1.0;
								rowPureAbsent = rowPureAbsent + 0.5;
								leaveIncrement = 0.5;
								if(leaveType == "SL")
								{
									displayStatus = if(isFH,"SL 1st","SL 2nd");
									badgeClass = if(isFH,"status-sl1","status-sl2");
									cellClasses = cellClasses + " cell-sl";
									rowSL = rowSL + leaveIncrement;
								}
								else if(leaveType == "LOP")
								{
									displayStatus = if(isFH,"LOP 1st","LOP 2nd");
									badgeClass = if(isFH,"status-lop1","status-lop2");
									cellClasses = cellClasses + " cell-lop";
									rowLOP = rowLOP + leaveIncrement;
								}
								else
								{
									displayStatus = if(isFH,"CL 1st","CL 2nd");
									badgeClass = if(isFH,"status-cl1","status-cl2");
									cellClasses = cellClasses + " cell-cl";
									rowCL = rowCL + leaveIncrement;
								}
								titleText = displayStatus + " + Absent";
							}
							else
							{
								rowAbsent = rowAbsent + 1.0;
								if(leaveType == "SL")
								{
									displayStatus = "SL";
									badgeClass = "status-leave-sick";
									cellClasses = cellClasses + " cell-sl";
									rowSL = rowSL + 1.0;
								}
								else if(leaveType == "LOP")
								{
									displayStatus = "LOP";
									badgeClass = "status-lop";
									cellClasses = cellClasses + " cell-lop";
									rowLOP = rowLOP + 1.0;
								}
								else
								{
									displayStatus = "CL";
									badgeClass = "status-leave-casual";
									cellClasses = cellClasses + " cell-cl";
									rowCL = rowCL + 1.0;
								}
								titleText = displayStatus + " Full Day Leave";
							}
						}
						else if(isHoliday)
						{
							displayStatus = "H";
							badgeClass = "status-holiday";
							titleText = holidayName;
							cellClasses = cellClasses + " cell-holiday";
							rowHoliday = rowHoliday + 1;
						}
						else
						{
							displayStatus = "A";
							badgeClass = "status-absent";
							titleText = "Absent";
							cellClasses = cellClasses + " cell-absent";
							rowAbsent = rowAbsent + 1.0;
							rowPureAbsent = rowPureAbsent + 1.0;
						}
					}
				}
				%>
<div class="calendar-day-cell<%=cellClasses%>">
<%
				if(inMonth)
				{
					%>
<div class="day-number"><%=cellDate.toString("dd")%></div>
<%
					if(showDash)
					{
						%>
<span class="text-muted" style="opacity: 0.4; font-weight: bold; font-size: 14px;">&mdash;</span>
<%
					}
					else if(displayStatus != "")
					{
						%>
<div>
<%
						if(hdLinkUrl != "")
						{
							%>
<a href="<%=hdLinkUrl%>" class="hd-link" title="<%=titleText%>"><span class="status-badge <%=badgeClass%>"><%=displayStatus%></span></a>
<%
						}
						else
						{
							%>
<span class="status-badge <%=badgeClass%>" title="<%=titleText%>"><%=displayStatus%></span>
<%
						}
						%>
</div>
<%
					}
				}
				%>
</div>
<%
			}
			%>
</div>
<%
		}
		%>
        <div class="summary-bar">
            <div class="summary-card sum-present"><span class="lbl">Present</span><span class="val"><%=rowPresent%></span></div>
            <div class="summary-card sum-absent"><span class="lbl">Absent</span><span class="val"><%=rowAbsent%></span></div>
            <div class="summary-card sum-hd"><span class="lbl">Half Days</span><span class="val"><%=rowHalfDay%></span></div>
            <div class="summary-card sum-sl"><span class="lbl">Sick Leave</span><span class="val"><%=rowSL%></span></div>
            <div class="summary-card sum-cl"><span class="lbl">Casual Leave</span><span class="val"><%=rowCL%></span></div>
            <div class="summary-card sum-lop"><span class="lbl">LOP</span><span class="val"><%=rowLOP%></span></div>
            <div class="summary-card sum-pure"><span class="lbl">Full Day Absent</span><span class="val"><%=rowPureAbsent%></span></div>
            <div class="summary-card sum-hol"><span class="lbl">Holiday</span><span class="val"><%=rowHoliday%></span></div>
        </div>
    </div>
<%
	}
	%>
<script>
        function fixLayout() {
            var headerHeight = document.querySelector('.header-container').offsetHeight;
            var calContainer = document.querySelector('.calendar-container');
            if (calContainer) {
                calContainer.style.height = 'calc(100vh - ' + headerHeight + 'px)';
            }
        }
        window.addEventListener('load', fixLayout);
        window.addEventListener('resize', fixLayout);
        setTimeout(fixLayout, 100);
        setTimeout(fixLayout, 300);
    </script>
</body>
</html>
<%
}%>
