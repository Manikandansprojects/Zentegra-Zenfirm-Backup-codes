	leadOffset = 0;
	if(firstDayName == "Sun")
	{
		leadOffset = 0;
	}
	else if(firstDayName == "Mon")
	{
		leadOffset = 1;
	}
	else if(firstDayName == "Tue")
	{
		leadOffset = 2;
	}
	else if(firstDayName == "Wed")
	{
		leadOffset = 3;
	}
	else if(firstDayName == "Thu")
	{
		leadOffset = 4;
	}
	else if(firstDayName == "Fri")
	{
		leadOffset = 5;
	}
	else if(firstDayName == "Sat")
	{
		leadOffset = 6;
	}
