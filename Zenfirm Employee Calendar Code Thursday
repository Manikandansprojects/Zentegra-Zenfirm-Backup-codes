	{
		baseDate = today.toStartOfMonth();
	}
	else
	{
		paramDate = input.d.toDate().toStartOfMonth();
		if(input.Next_btn == true)
		{
			baseDate = paramDate.addMonth(1);
		}
		else if(input.Next_btn == false)
		{
			baseDate = paramDate.subMonth(1);
		}
		else
		{
			baseDate = paramDate;
		}
	}
