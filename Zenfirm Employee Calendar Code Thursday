						{
							finalLeaveType = "CL";
						}
						else if(sickTaken > 0 && casualTaken > 0)
						{
							if(sickTaken >= casualTaken)
							{
								finalLeaveType = "SL";
							}
							else
							{
								finalLeaveType = "CL";
							}
						}
						else
						{
							finalLeaveType = "CL";
						}
					}
					else if(leaveTypeUpper.contains("SICK"))
					{
						finalLeaveType = "SL";
					}
					else if(leaveTypeUpper.contains("CASUAL"))
					{
						finalLeaveType = "CL";
					}
					else if(leaveTypeUpper.contains("PLANED") || leaveTypeUpper.contains("PLANNED"))
					{
						finalLeaveType = "CL";
					}
					else
					{
						if(sickTaken > 0)
						{
							finalLeaveType = "SL";
