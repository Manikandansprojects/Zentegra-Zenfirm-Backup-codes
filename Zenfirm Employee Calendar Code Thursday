	totalCells = leadOffset + daysInMonth;
	totalWeeks = (totalCells - 1) / 7 + 1;
	maxWeekSlots = {0,1,2,3,4,5};
	weekIndexList = List();
	for each  wk in maxWeekSlots
	{
		if(wk < totalWeeks)
		{
			weekIndexList.add(wk);
		}
	}
