        .tile-holiday-wide .ico { width: 30px; height: 30px; border-radius: 8px; background: #fce7f3; color: #db2777; display: flex; align-items: center; justify-content: center; font-size: 12px; flex-shrink: 0; }
        .tile-holiday-wide .lbl { display: block; font-size: 10px; font-weight: 600; color: #6b7280; }
        .tile-holiday-wide .val { display: block; margin-top: 1px; font-size: 16px; font-weight: 700; color: #831843; }

        .calendar-wrap { grid-area: calendar; background: #fff; border: 1px solid #edf0f5; border-radius: 14px; box-shadow: 0 8px 24px rgba(16,24,40,0.04); overflow: hidden; margin-bottom: 0; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; }
        .calendar-weekday-header { display: grid; grid-template-columns: repeat(7, 1fr); border-bottom: 1px solid #edf0f4; background: #fff; }
        .calendar-weekday-header div { text-align: center; font-size: 10px; font-weight: 600; color: #6b7280; padding: 10px 4px; letter-spacing: 0.2px; }
        .calendar-week-row { display: grid; grid-template-columns: repeat(7, 1fr); }
        .calendar-week-row + .calendar-week-row { border-top: 1px solid #edf0f4; }
        .calendar-day-cell { min-height: 84px; padding: 8px; background: #fff; display: flex; flex-direction: column; align-items: stretch; border-right: 1px solid #edf0f4; transition: background 0.2s; }
        .calendar-day-cell:last-child { border-right: none; }
        .calendar-day-cell.weekend-col { background: #fff; }
        .calendar-day-cell.today-cell { box-shadow: inset 0 0 0 2px #6d5efc; z-index: 10; position: relative; }
        .calendar-day-cell.empty-cell { background: #fff; }
        .calendar-day-cell.empty-cell .day-number { color: #d3d8e0; font-weight: 500; }

        .cell-present-bg { background-color: #f0fdf4 !important; }
        .cell-sh-bg { background-color: #fffbeb !important; }
        .cell-sl-bg { background-color: #fff1f2 !important; }
        .cell-cl-bg { background-color: #fff7ed !important; }
        .cell-lop-bg { background-color: #fef2f2 !important; }
        .cell-absent-bg { background-color: #fff1f2 !important; }
        .cell-holiday-bg { background-color: #fdf2f8 !important; }

        .day-number { font-size: 11px; font-weight: 500; color: #374151; line-height: 1; align-self: flex-start; }
        .day-number.sun-num { color: #f43f5e; }
        .day-number.sat-num { color: #6d5efc; }
        .today-cell .day-number { color: #4f46e5; font-weight: 800; }

        .cell-status { flex: 1; display: flex; align-items: center; justify-content: center; }
        .hd-link { text-decoration: none !important; display: inline-block; cursor: pointer; }
        .hd-link:hover .status-badge { transform: scale(1.04); }

        .status-badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 7px; border-radius: 5px; font-size: 10px; font-weight: 600; line-height: 1.2; white-space: nowrap; }
        .status-badge i { font-size: 12px; }
        .status-fd { background: #dcfce7; color: #16a34a; }
        .status-fd i { color: #22c55e; }
        .status-sh { background: #fff3df; color: #d97706; }
        .status-absent { background: #fee2e2; color: #dc2626; }
        .status-holiday { background: #fce7f3; color: #be185d; }
        .status-leave-sick, .status-sl1, .status-sl2 { background: #ffe6ea; color: #e11d48; }
        .status-leave-casual, .status-cl1, .status-cl2 { background: #ffedf4; color: #db2777; }
        .status-lop, .status-lop1, .status-lop2 { background: #fecaca; color: #991b1b; }
        .status-w { background: #f1f5f9; color: #4b5563; }
        .status-w i { color: #6b7280; }

        .legend-row { grid-area: legend; display: flex; align-items: center; justify-content: left; gap: 14px; flex-wrap: wrap; padding: 4px 0 0; color: #6b7280; font-size: 10px; align-self: start; margin-top: -28px; }
        .legend-item { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; font-weight: 600; }
        .legend-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
        .dot-p { background: #22c55e; }
        .dot-h { background: #f59e0b; }
        .dot-cl { background: #f43f5e; }
        .dot-sl { background: #e11d48; }
        .dot-lop { background: #dc2626; }
        .dot-a { background: #fb7185; }
        .dot-hol { background: #ec4899; }
        .legend-note { margin-left: auto; font-size: 9px; color: #9ca3af; }
        .no-employee-msg { padding: 40px 20px; text-align: center; color: #a31d1d; font-size: 11px; font-weight: 600; }

        .app-shell::-webkit-scrollbar { width: 8px; height: 8px; }
        .app-shell::-webkit-scrollbar-track { background: #f1f3f5; }
        .app-shell::-webkit-scrollbar-thumb { background: #ced4da; border-radius: 4px; }

        @media (max-width: 1100px) {
            .content-grid { grid-template-columns: 1fr; grid-template-areas: "profile" "calendar" "leavesum" "legend"; }
        }
        @media (max-width: 768px) {
            .calendar-day-cell { min-height: 72px; padding: 6px; }
            .nav-center { margin-left: 0; width: 100%; justify-content: space-between; }
        }
		/* ===== Short Hours Popup (pure CSS, no JS) ===== */
		.sh-toggle {
			position: absolute;
			opacity: 0;
			width: 0;
			height: 0;
			margin: 0;
			pointer-events: none;
		}

		.sh-modal-overlay {
			display: none;
			position: fixed;
			top: 0; right: 0; bottom: 0; left: 0;
			background: rgba(17,24,39,0.55);
			z-index: 9999;
			align-items: center;
			justify-content: center;
			padding: 20px;
		}

		/* This one line opens the popup */
		.sh-toggle:checked ~ .sh-modal-overlay { display: flex; }

		.sh-backdrop {
			position: absolute;
			top: 0; right: 0; bottom: 0; left: 0;
			cursor: pointer;
			margin: 0;
		}

		.sh-modal-box {
			position: relative;
			z-index: 1;
			background: #fff;
			width: 500px;
			max-width: 723px;
			border-radius: 16px;
			box-shadow: 0 24px 60px rgba(16,24,40,0.28);
			overflow: hidden;
		}

		.sh-modal-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 10px;
			padding: 12px 16px;
			background: #5b21b6;
			color: #fff;
		}
		.sh-modal-title {
			display: flex;
			align-items: center;
			gap: 8px;
			font-size: 16px;
			font-weight: 700;
		}
		.sh-modal-title i { font-size: 12px; }
		.sh-modal-sub {
			font-size: 10px;
			font-weight: 500;
			opacity: 0.85;
			margin-top: 3px;
		}
		.sh-modal-close {
			width: 28px;
			height: 28px;
			border-radius: 8px;
			background: rgba(255,255,255,0.18);
			color: #fff;
			font-size: 12px;
			cursor: pointer;
			display: flex;
			align-items: center;
			justify-content: center;
			margin: 0;
			flex-shrink: 0;
			transition: 0.2s;
		}
		.sh-modal-close:hover { background: rgba(255,255,255,0.34); }

		.sh-modal-body { background: #f8f9fc; }
		.sh-modal-body iframe {
			width: 100%;
			height: 633px;
			border: 0;
			display: block;
		}

		label.hd-link { cursor: pointer; margin: 0; }

		@media (max-width: 768px) {
			.sh-modal-box { max-width: 100%; }
			.sh-modal-body iframe { height: 70vh; }
		}
		.desp { display: inline-flex; align-items: center; gap: 4px; padding: 3px 7px; border-radius: 5px; font-size: 10px; font-weight: 600; line-height: 1.2; white-space: nowrap; color: #f59e0b; }
    </style>
</head>
<body>
<div class="app-shell">
    <div class="top-navbar">
        <div class="brand-wrap">
            <div class="brand-cal-icon"><img src="https://cdn-icons-png.flaticon.com/128/833/833593.png" alt="Calendar"></div>
            <div>
                <div class="brand-title">Employee Calendar</div>
                <div class="brand-sub">Monthly Attendance & Leave Overview</div>
            </div>
        </div>
        <div class="nav-center">
            <div class="month-nav">
                <a href="#Page:emp_attendance?d=<%=baseDate.toString("dd-MMM-yyyy")%>&Next_btn=false&employee_email=<%=input.employee_email%>" class="month-nav-btn"><i class="fas fa-chevron-left"></i></a>
                <span class="current-month"><i class="far fa-calendar"></i> <%=baseDate.toString("MMMM yyyy")%></span>
               	<a href="#Page:emp_attendance?d=<%=baseDate.toString("dd-MMM-yyyy")%>&Next_btn=true&employee_email=<%=input.employee_email%>" class="month-nav-btn"><i class="fas fa-chevron-right"></i></a>
            </div>
            <a href="#Page:emp_attendance?d=<%=zoho.currentdate.toString("dd-MMM-yyyy")%>&employee_email=<%=input.employee_email%>" class="today-btn"><i class="far fa-calendar"></i> Today</a>
        </div>
    </div>
<%
	if(input.employee_email == "")
	{
		%>
<div class="no-employee-msg">No employee selected. Add <code>employee_email</code> to the page URL to view a calendar.</div>
<%
	}
	else
	{
		%>
<div class="content-grid">
    <aside class="profile-card">
        <img src="<%=photoSource%>" class="emp-avatar-lg" alt="<%=ifnull(targetEmpName,"Employee")%>" onerror="this.onerror=null;this.src='<%=fallbackAvatar%>';">
        <div class="profile-name"><%=if(targetEmpName == "","No Employee Selected",targetEmpName)%></div>
        <div class="profile-role"><%=targetemployeerole%></div>
    </aside>

    <div class="calendar-wrap">
        <div class="calendar-weekday-header">
            <div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div>
        </div>
<%
		for each  weekNum in weekIndexList
		{
			%>
<div class="calendar-week-row">
<%
			for each  dow in dowIndexList
			{
				cellIndex = weekNum * 7 + dow;
				cellDate = gridStart.addDay(cellIndex);
				inMonth = cellDate.toStartOfMonth() == baseDate;
				isWeekendCol = dow == 0 || dow == 6;
				isToday = cellDate.toString("dd-MM-yyyy") == input.t;
				cellClasses = "calendar-day-cell";
				if(isWeekendCol)
				{
					cellClasses = cellClasses + " weekend-col";
				}
				if(isToday && inMonth)
				{
					cellClasses = cellClasses + " today-cell";
				}
				if(!inMonth)
				{
					cellClasses = cellClasses + " empty-cell";
				}
				displayStatus = "";
				badgeClass = "";
				titleText = "";
				hdLinkUrl = "";
				showDash = false;
				uiLabel = "";
				uiIcon = "";
				if(inMonth)
				{
					isFuture = cellDate > zoho.currentdate;
					dateKey = cellDate.toString("yyyy-MM-dd");
					// ============================================================
					// HOLIDAY CHECK FIRST — past, today AND future dates
					// ============================================================
					holidayName = "";
					isHoliday = false;
					hi = 0;
					for each  hd in holidayDates
					{
						if(!isHoliday)
						{
							if(hd == dateKey)
							{
								isHoliday = true;
								holidayName = holidayNames.get(hi);
							}
						}
						hi = hi + 1;
					}
					if(isHoliday)
					{
						displayStatus = "H";
						badgeClass = "status-holiday";
						titleText = holidayName;
						cellClasses = cellClasses + " cell-holiday-bg";
						rowHoliday = rowHoliday + 1;
					}
					else if(isWeekendCol)
					{
						displayStatus = "W";
						badgeClass = "status-w";
						titleText = "Weekend";
					}
					else if(isFuture)
					{
						showDash = true;
					}
					else
					{
						hasLeave = false;
						leaveType = "";
						brVal = "";
						li = 0;
						for each  ld in leaveDates
						{
							if(!hasLeave)
							{
								if(ld == dateKey)
								{
									hasLeave = true;
									leaveType = leaveTypes.get(li);
									brVal = leaveBrs.get(li);
								}
							}
							li = li + 1;
						}
						isHalfDay = false;
						isFH = false;
						if(hasLeave)
						{
							brLower = ifnull(brVal,"").toLowerCase();
							if(brLower.contains("first half") || brLower.contains("1st") || brLower.contains("fh"))
							{
								isHalfDay = true;
								isFH = true;
							}
							else if(brLower.contains("second half") || brLower.contains("2nd") || brLower.contains("sh") || brLower.contains("half"))
							{
								isHalfDay = true;
							}
						}
						hrsVal = attendanceMap.get(dateKey);
						hasPunch = hrsVal != null;
						hoursWorked = 0.0;
						if(hasPunch)
						{
							try 
							{
								hoursWorked = hrsVal.toDecimal();
							}							catch (eHrs)
							{
								try 
								{
									hoursWorked = hrsVal;
								}								catch (eHrs2)
								{
									hoursWorked = 0.0;
								}
							}
						}
						if(hasPunch)
						{
							if(hoursWorked >= 8.0)
							{
								displayStatus = "P";
								badgeClass = "status-fd";
								titleText = "Full Day Present (" + hoursWorked + " hrs)";
								rowPresent = rowPresent + 1;
							}
							else if(hasLeave && isHalfDay)
							{
								if(hoursWorked >= 4.0)
								{
									rowPresent = rowPresent + 0.5;
									rowAbsent = rowAbsent + 0.5;
									rowHalfDay = rowHalfDay + 1;
								}
								else
								{
									rowAbsent = rowAbsent + 1.0;
									rowPureAbsent = rowPureAbsent + 0.5;
								}
								leaveIncrement = 0.5;
								if(leaveType == "SL")
								{
									displayStatus = if(isFH,"SL 1st","SL 2nd");
									badgeClass = if(isFH,"status-sl1","status-sl2");
									rowSL = rowSL + leaveIncrement;
								}
								else if(leaveType == "LOP")
								{
									displayStatus = if(isFH,"LOP 1st","LOP 2nd");
									badgeClass = if(isFH,"status-lop1","status-lop2");
									rowLOP = rowLOP + leaveIncrement;
								}
								else
								{
									displayStatus = if(isFH,"CL 1st","CL 2nd");
									badgeClass = if(isFH,"status-cl1","status-cl2");
									rowCL = rowCL + leaveIncrement;
								}
								titleText = displayStatus + " + Worked (" + hoursWorked + " hrs)";
							}
							else if(hasLeave && !isHalfDay)
							{
								rowAbsent = rowAbsent + 1.0;
								if(leaveType == "SL")
								{
									displayStatus = "SL";
									badgeClass = "status-leave-sick";
									rowSL = rowSL + 1.0;
								}
								else if(leaveType == "LOP")
								{
									displayStatus = "LOP";
									badgeClass = "status-lop";
									rowLOP = rowLOP + 1.0;
								}
								else
								{
									displayStatus = "CL";
									badgeClass = "status-leave-casual";
									rowCL = rowCL + 1.0;
								}
								titleText = displayStatus + " Full Day Leave (Worked " + hoursWorked + " hrs)";
							}
							else
							{
								if(isToday)
								{
									displayStatus = "";
									badgeClass = "";
									titleText = "Today in progress (" + hoursWorked + " hrs)";
								}
								else
								{
									if(hoursWorked >= 4.0)
									{
										rowPresent = rowPresent + 0.5;
										rowAbsent = rowAbsent + 0.5;
										rowHalfDay = rowHalfDay + 1;
									}
									else
									{
										rowAbsent = rowAbsent + 1.0;
										rowPureAbsent = rowPureAbsent + 1.0;
									}
									dateFormatted = cellDate.toString("dd-MMM-yyyy");

									// Popup form URL for Short Hours (form-embed version)
									hdLinkUrl = "https://creatorapp.zohopublic.in/zentegraindia/attendance-payroll-management/form-embed/Attendance_Regularization/rQKJJr5sVeFsDKXuynymhz0S9PxeZ39jPhY4vTjfXPRKwkPh8unh8pWQUEeBumqarGzCwqGhNxxFQ3ZpP4n8jqTTgfpVJwweN91G?&Employee=" + targetEmpID + "&Date_field=" + dateFormatted;
									displayStatus = "SH";
									badgeClass = "status-sh";
									titleText = "Short Hours - " + targetEmpName + " on " + dateFormatted + " (" + hoursWorked + " hrs) - Click To Request Regularize";
									
								}
							}
						}
						else if(hasLeave)
						{
							if(isHalfDay)
							{
								rowAbsent = rowAbsent + 1.0;
								rowPureAbsent = rowPureAbsent + 0.5;
								leaveIncrement = 0.5;
								if(leaveType == "SL")
								{
									displayStatus = if(isFH,"SL 1st","SL 2nd");
									badgeClass = if(isFH,"status-sl1","status-sl2");
									rowSL = rowSL + leaveIncrement;
								}
								else if(leaveType == "LOP")
								{
									displayStatus = if(isFH,"LOP 1st","LOP 2nd");
									badgeClass = if(isFH,"status-lop1","status-lop2");
									rowLOP = rowLOP + leaveIncrement;
								}
								else
								{
									displayStatus = if(isFH,"CL 1st","CL 2nd");
									badgeClass = if(isFH,"status-cl1","status-cl2");
									rowCL = rowCL + leaveIncrement;
								}
								titleText = displayStatus + " + Absent";
							}
							else
							{
								rowAbsent = rowAbsent + 1.0;
								if(leaveType == "SL")
								{
									displayStatus = "SL";
									badgeClass = "status-leave-sick";
									rowSL = rowSL + 1.0;
								}
								else if(leaveType == "LOP")
								{
									displayStatus = "LOP";
									badgeClass = "status-lop";
									rowLOP = rowLOP + 1.0;
								}
								else
								{
									displayStatus = "CL";
									badgeClass = "status-leave-casual";
									rowCL = rowCL + 1.0;
								}
								titleText = displayStatus + " Full Day Leave";
							}
						}
						else
						{
							if(isToday)
							{
								displayStatus = "";
								badgeClass = "";
								titleText = "Today";
							}
							else
							{
								displayStatus = "A";
								badgeClass = "status-absent";
								titleText = "Absent";
								rowAbsent = rowAbsent + 1.0;
								rowPureAbsent = rowPureAbsent + 1.0;
							}
						}
					}
					if(displayStatus == "P")
					{
						uiLabel = "Present";
						uiIcon = "fas fa-circle";
						cellClasses = cellClasses + " cell-present-bg";
					}
					else if(displayStatus == "SH")
					{
						uiLabel = "Short Hours";
						uiLabelDescription = "Click to Request Regularization";
						uiIcon = "fas fa-clock";
						cellClasses = cellClasses + " cell-sh-bg";
					}
					else if(displayStatus == "A")
					{
						uiLabel = "Absent";
						uiIcon = "fas fa-user-xmark";
						cellClasses = cellClasses + " cell-absent-bg";
					}
					else if(displayStatus == "H")
					{
						uiLabel = "Holiday";
						uiIcon = "fas fa-umbrella-beach";
						cellClasses = cellClasses + " cell-holiday-bg";
					}
					else if(displayStatus == "CL")
					{
						uiLabel = "Casual Leave";
						uiIcon = "fas fa-briefcase";
						cellClasses = cellClasses + " cell-cl-bg";
					}
					else if(displayStatus == "CL 1st")
					{
						uiLabel = "CL 1st Half";
						uiIcon = "fas fa-briefcase";
						cellClasses = cellClasses + " cell-cl-bg";
					}
					else if(displayStatus == "CL 2nd")
					{
						uiLabel = "CL 2nd Half";
						uiIcon = "fas fa-briefcase";
						cellClasses = cellClasses + " cell-cl-bg";
					}
					else if(displayStatus == "SL")
					{
						uiLabel = "Sick Leave";
						uiIcon = "fas fa-briefcase";
						cellClasses = cellClasses + " cell-sl-bg";
					}
					else if(displayStatus == "SL 1st")
					{
						uiLabel = "SL 1st Half";
						uiIcon = "fas fa-briefcase";
						cellClasses = cellClasses + " cell-sl-bg";
					}
					else if(displayStatus == "SL 2nd")
					{
						uiLabel = "SL 2nd Half";
						uiIcon = "fas fa-briefcase";
						cellClasses = cellClasses + " cell-sl-bg";
					}
					else if(displayStatus == "LOP")
					{
						uiLabel = "LOP";
						uiIcon = "fas fa-ban";
						cellClasses = cellClasses + " cell-lop-bg";
					}
					else if(displayStatus == "LOP 1st")
					{
						uiLabel = "LOP 1st Half";
						uiIcon = "fas fa-ban";
						cellClasses = cellClasses + " cell-lop-bg";
					}
					else if(displayStatus == "LOP 2nd")
					{
						uiLabel = "LOP 2nd Half";
						uiIcon = "fas fa-ban";
						cellClasses = cellClasses + " cell-lop-bg";
					}
					else if(displayStatus == "W")
					{
						uiLabel = "Week Off";
						uiIcon = "fas fa-mug-hot";
					}
				}
				dayNumClass = "day-number";
				if(inMonth)
				{
					if(dow == 0)
					{
						dayNumClass = dayNumClass + " sun-num";
					}
					if(dow == 6)
					{
						dayNumClass = dayNumClass + " sat-num";
					}
				}
				%>
<div class="<%=cellClasses%>" title="<%=titleText%>">
<div class="<%=dayNumClass%>"><%=cellDate.toString("dd")%></div>
<%
				if(inMonth)
				{
					%>
<div class="cell-status">
<%
					if(showDash)
					{
						%>
